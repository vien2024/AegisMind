# ---------------------------------------------------------------------------
# AegisMind example environment. Copy to `.env` and edit:
#     cp .env.example .env
# Every value is optional — with no API key the agents run against the built-in
# offline simulator, so you can start the UI immediately.
# ---------------------------------------------------------------------------

# --- model providers (add one to run agents live) ---------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCAROUTER_API_KEY=sk-orca-...

# Default model per provider (only used for environment-key fallback)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- storage ----------------------------------------------------------------
# Postgres connection string (required when running with the Postgres backend).
#   Local:  DATABASE_URL=postgresql://aegismind:aegismind@localhost:5432/aegismind
#   Docker Compose (defaults baked into compose file, override here if needed):
#           DATABASE_URL=postgresql://aegismind:aegismind@postgres:5432/aegismind
DATABASE_URL=postgresql://aegismind:aegismind@localhost:5432/aegismind

# --- server -----------------------------------------------------------------
# PORT=3000
# HOSTNAME=0.0.0.0
# Set to "ko" for Korean, "en" for English
# AEGISMIND_LANGUAGE=en
