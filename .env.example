# ---------------------------------------------------------------------------
# AegisMind example environment. Copy to `.env` and edit:
#     cp .env.example .env
# Provider credentials are optional for the UI, but a live model is required
# before any task agent can run. Local Ollama/Mistral endpoints can use no key.
# ---------------------------------------------------------------------------

# --- model providers (configure a live provider to run agents) --------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...
# ORCAROUTER_API_KEY=sk-orca-...
# MISTRAL_API_KEY=...
# OLLAMA_API_KEY=...

# Default model per provider (only used for environment-key fallback)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- storage ----------------------------------------------------------------
# Postgres connection string (required when running with the Postgres backend).
#   Local:  DATABASE_URL=postgresql://aegismind:aegismind@localhost:5432/aegismind
#   Docker Compose (defaults baked into compose file, override here if needed):
#           DATABASE_URL=postgresql://aegismind:aegismind@postgres:5432/aegismind
DATABASE_URL=postgresql://aegismind:aegismind@localhost:5432/aegismind

# --- server -----------------------------------------------------------------
# PORT=3000
# HOSTNAME=0.0.0.0
# Set to "ko" for Korean, "en" for English
# AEGISMIND_LANGUAGE=en

# Live vulnerability validation is opt-in. Each probe still requires manual approval.
# AEGISMIND_ENABLE_LIVE_VALIDATION=true
# Allow explicitly scoped private-network targets and non-standard HTTP ports.
# Metadata and link-local addresses remain blocked.
# AEGISMIND_ALLOW_PRIVATE_VALIDATION_TARGETS=true

# MCP servers and their agent assignment are managed per server in the MCP page.
# Choose Planner or All subagents there; agent tool calls require operator approval.
# Per-task time limits are set on the task form (1-1440 minutes); blank means unlimited.
